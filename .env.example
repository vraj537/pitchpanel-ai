# ---- Django ----------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# ---- Database: Supabase Postgres --------------------------------------
# Get this from Supabase -> Project Settings -> Database -> Connection string.
# Use the "Transaction pooler" URI (port 6543), not the direct connection —
# it works properly with Vercel's short-lived serverless functions.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---- Gemini API --------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Max pitches a single user can validate per 24 hours (free-tier friendly).
DAILY_PITCH_LIMIT=3

# ---- Email (Gmail SMTP, used for "forgot password" emails) -------------
# Use a Gmail App Password, not your normal Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
